FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements-homelab-copilot-agent.txt ./requirements-homelab-copilot-agent.txt
RUN pip install --no-cache-dir -r requirements-homelab-copilot-agent.txt

COPY advisor_agent_patch.py ./advisor_agent_patch.py

EXPOSE 8085

CMD ["python", "/app/advisor_agent_patch.py"]